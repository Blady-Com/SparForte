#if GCGI
-----------------------------------------------------------------------------
--  PARSE GNAT CGI PUT HEADER                            (built-in procedure)
--
-- AdaScript Syntax: gnat.cgi.put_header [(f) | (h [,f])]
--       Ada Target: GNAT.CGI.Put_Header
--   GNAT Spec File: g-cgi.ads
--   SparForte Docs: doc/pkg_gnat_cgi.html
-----------------------------------------------------------------------------

procedure ParseGnatCGIPutHeader is
  expr  : storage;
  expr_type : identifier;
  expr2Expr  : storage;
  expr2_type : identifier;
  Header : unbounded_string := to_unbounded_string( GNAT.CGI.Default_Header );
  force  : boolean := false;
  bt : identifier;
  subprogramId : constant identifier := gnat_cgi_put_header_t;
begin
  expect( subprogramId );
  if token = symbol_t and identifiers( token ).store.value = "(" then
     expect( symbol_t, "(" );
     ParseExpression( expr, expr_type );
     bt := getBaseType( expr_type );
     if bt = string_t or bt = uni_string_t or bt = universal_t then
        baseTypesOK( expr_type, string_t );
        header := expr.value;
        if token = symbol_t and identifiers( token ).store.value = "," then
           expect( symbol_t, "," );
           ParseExpression( expr2Expr, expr2_type );
           if baseTypesOK( expr2_type, boolean_t ) then
               force := "1" = to_string( expr2Expr.value );
           end if;
        end if;
        expect( symbol_t, ")" );
     elsif bt = boolean_t then
        baseTypesOK( expr_type, boolean_t );
        force := "1" = to_string( expr.value );

        expect( symbol_t, ")" );
     else
        err( +"string or boolean expected" );
     end if;
  end if;

  if isExecutingCommand then
     begin
       Gnat.CGI.Put_Header( to_string( header ), force );
     exception when Gnat.Cgi.Data_Error =>
       err( +"data_error exception" );
     when Gnat.Cgi.Parameter_Not_Found =>
       err( +"parameter_not_found exception" );
     when others =>
       err_exception_raised;
     end;
  end if;
end ParseGnatCGIPutHeader;

#else

procedure not_configured is
begin
  err( +"gnat.cgi support not configured" );
end not_configured;

pragma warnings( Off );
-- Hide unused parameters warnings

procedure ParseGnatCGIPutHeader is
begin
  not_configured;
end ParseGnatCGIPutHeader;

#end if;
#if GCGI
-----------------------------------------------------------------------------
--  PARSE GNAT CGI OK                                     (built-in function)
--
-- AdaScript Syntax: bool := gnat.cgi.ok
--       Ada Target: GNAT.CGI.OK
--   GNAT Spec File: g-cgi.ads
--   SparForte Docs: doc/pkg_gnat_cgi.html
-----------------------------------------------------------------------------

procedure ParseGnatCGIOK( result : out storage; kind : out identifier ) is
  subprogramId : constant identifier := gnat_cgi_ok_t;
begin
  kind := boolean_t;
  expect( subprogramId );
  if isExecutingCommand then
     begin
       result := storage'( to_spar_boolean( gnat.cgi.ok ), noMetaTag, sparMetaTags );
     exception when Gnat.Cgi.Data_Error =>
       err( +"data_error exception" );
     when others =>
       err_exception_raised;
     end;
  end if;
end ParseGnatCGIOK;

#else

procedure ParseGnatCGIOK( result : out storage; kind : out identifier ) is
begin
  not_configured;
end ParseGnatCGIOK;

#end if;
#if GCGI
-----------------------------------------------------------------------------
--  PARSE GNAT CGI METHOD                                 (built-in function)
--
-- AdaScript Syntax: method := gnat.cgi.method
--       Ada Target: GNAT.CGI.Method
--   GNAT Spec File: g-cgi.ads
--   SparForte Docs: doc/pkg_gnat_cgi.html
-----------------------------------------------------------------------------

procedure ParseGnatCGIMethod( result : out storage; kind : out identifier ) is
  mt : gnat.cgi.method_type;
  subprogramId : constant identifier := gnat_cgi_method_t;
begin
  kind := gnat_cgi_method_type_t;
  expect( subprogramId );
  if isExecutingCommand then
     begin
       mt := gnat.cgi.method;
       result := storage'( to_unbounded_string(
                   integer'image(
                      gnat.cgi.method_type'pos( mt )
                   )(2)&""
                 ), noMetaTag, sparMetaTags );
     exception when Gnat.Cgi.Data_Error =>
       err( +"data_error exception" );
     when Gnat.Cgi.Parameter_Not_Found =>
       err( +"parameter_not_found exception" );
     when others =>
       err_exception_raised;
     end;
  end if;
end ParseGnatCGIMethod;

#else

procedure ParseGnatCGIMethod( result : out storage; kind : out identifier ) is
begin
  not_configured;
end ParseGnatCGIMethod;

#end if;
#if GCGI
-----------------------------------------------------------------------------
--  PARSE GNAT CGI METAVARIABLE                           (built-in function)
--
-- AdaScript Syntax: value := gnat.cgi.metavariable( key [, required] )
--       Ada Target: GNAT.CGI.Metavariable
--   GNAT Spec File: g-cgi.ads
--   SparForte Docs: doc/pkg_gnat_cgi.html
-----------------------------------------------------------------------------

procedure ParseGnatCGIMetavariable( result : out storage; kind : out identifier ) is
  metaExpr   : storage;
  meta_type  : identifier;
  boolExpr   : storage;
  bool_type  : identifier := boolean_t;
  subprogramId : constant identifier := gnat_cgi_metavariable_t;
begin
  kind := string_t;
  expect( subprogramId );
  expect( symbol_t, "(" );
  ParseExpression( metaExpr, meta_type );
  if baseTypesOk( meta_type, gnat_cgi_metavariable_name_t ) then
     if token = symbol_t and identifiers( token ).store.value = "," then
        expect( symbol_t, "," );
        ParseExpression( boolExpr, bool_type );
        baseTypesOk( bool_type, boolean_t );
     end if;
  end if;
  expect( symbol_t, ")" );
  if isExecutingCommand then
     boolExpr.value := identifiers( false_t ).store.value;
     begin
       result := storage'( to_unbounded_string( Gnat.Cgi.Metavariable(
          gnat.cgi.metavariable_name'val( integer'value( " " & to_string( metaExpr.value ) ) ),
          boolExpr.value = identifiers( true_t ).store.value
       ) ), noMetaTag, sparMetaTags );
     exception when Gnat.Cgi.Data_Error =>
       err( +"data_error exception" );
     when Gnat.Cgi.Parameter_Not_Found =>
       err( +"parameter_not_found exception" );
     when others =>
       err_exception_raised;
     end;
  end if;
end ParseGnatCGIMetavariable;

#else

procedure ParseGnatCGIMetavariable( result : out storage; kind : out identifier ) is
begin
  not_configured;
end ParseGnatCGIMetavariable;

#end if;
