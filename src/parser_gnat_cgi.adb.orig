procedure ParseGnatCGICookieCount( result : out storage; kind : out identifier ) is
begin
  not_configured;
end ParseGnatCGICookieCount;

#end if;
#if GCGI
-----------------------------------------------------------------------------
--  PARSE GNAT CGI COOKIE VALUE                           (built-in function)
--
-- AdaScript Syntax: s:= gnat.cgi.cookie.value( key [,required] ) | ( pos )
--       Ada Target: GNAT.CGI.Cookie_Value
--   GNAT Spec File: g-cgi.ads
--   SparForte Docs: doc/pkg_gnat_cgi.html
-----------------------------------------------------------------------------

procedure ParseGnatCGICookieValue( result : out storage; kind : out identifier ) is
  expr  : storage;
  expr_type : identifier;
  base_type : identifier;
  boolExpr  : storage;
  bool_type : identifier := boolean_t;
  key_version : boolean := false;
  subprogramId : constant identifier := gnat_cgi_cookie_value_t;
begin
  kind := string_t;
  boolExpr.value := identifiers( false_t ).store.value;
  expect( subprogramId );
  expect( symbol_t, "(" );
  ParseExpression( expr, expr_type );
  base_type := getBaseType( expr_type );
  if base_type = string_t or base_type = uni_string_t or base_type = universal_t then
     key_version := true;
     if baseTypesOk( expr_type, string_t ) then
        if token = symbol_t and identifiers( token ).store.value = "," then
           expect( symbol_t, "," );
           ParseExpression( boolExpr, bool_type );
           if baseTypesOk( bool_type, boolean_t ) then
              null;
           end if;
        end if;
     end if;
  elsif base_type = positive_t or base_type = uni_numeric_t then
     key_version := false;
     baseTypesOk( expr_type, positive_t );
  else
     err( +"positive or string expected" );
  end if;
  expect( symbol_t, ")" );
  if isExecutingCommand then
    if metaTagOK( subprogramId, expr ) then
       begin
         if key_version then
            result := storage'( to_unbounded_string( gnat.cgi.cookie.value(
              to_string( expr.value ),
              boolExpr.value = identifiers( true_t ).store.value
              ) ), noMetaTag, expr.policyMetaTags  );
         else
             result := storage'( to_unbounded_string( gnat.cgi.cookie.value(
               positive'value( " " & to_string( expr.value ) )
               ) ), noMetaTag, sparMetaTags );
         end if;
       exception when Gnat.Cgi.Data_Error =>
         err( +"data_error exception" );
       when Gnat.Cgi.Parameter_Not_Found =>
         err( +"parameter_not_found exception" );
       when Gnat.Cgi.Cookie.Cookie_Not_Found =>
         err( +"cookie_not_found exception" );
       when others =>
         err_exception_raised;
       end;
    end if;
  end if;
end ParseGnatCGICookieValue;

#else

procedure ParseGnatCGICookieValue( result : out storage; kind : out identifier ) is
begin
  not_configured;
end ParseGnatCGICookieValue;

#end if;
#if GCGI
-----------------------------------------------------------------------------
--  PARSE GNAT CGI COOKIE EXISTS                          (built-in function)
--
-- AdaScript Syntax: bool := gnat.cgi.cookie.exists( key )
--       Ada Target: GNAT.CGI.Cookie_Exists
--   GNAT Spec File: g-cgi.ads
--   SparForte Docs: doc/pkg_gnat_cgi.html
-----------------------------------------------------------------------------

procedure ParseGnatCGICookieExists( result : out storage; kind : out identifier ) is
  keyExpr : storage;
  key_type : identifier;
  subprogramId : constant identifier := gnat_cgi_cookie_exists_t;
begin
  kind := boolean_t;
  expect( subprogramId );
  ParseSingleStringParameter( gnat_cgi_cookie_exists_t, keyExpr, key_type );
  if isExecutingCommand then
    if metaTagOK( subprogramId, keyExpr ) then
       begin
         result := storage'( to_spar_boolean(
           gnat.cgi.cookie.exists( to_string( keyExpr.value ))
           ), noMetaTag, sparMetaTags );
       exception when Gnat.Cgi.Data_Error =>
         err( +"data_error exception" );
       when Gnat.Cgi.Parameter_Not_Found =>
         err( +"parameter_not_found exception" );
       when Gnat.Cgi.Cookie.Cookie_Not_Found =>
         err( +"cookie_not_found exception" );
       when others =>
         err_exception_raised;
       end;
    end if;
  end if;
end ParseGnatCGICookieExists;

#else

procedure ParseGnatCGICookieExists( result : out storage; kind : out identifier ) is
begin
  not_configured;
end ParseGnatCGICookieExists;

#end if;
#if GCGI
-----------------------------------------------------------------------------
--  PARSE GNAT CGI COOKIE KEY                             (built-in function)
--
-- AdaScript Syntax: s := gnat.cgi.cookie.key( pos )
--       Ada Target: GNAT.CGI.Cookie_Key
--   GNAT Spec File: g-cgi.ads
--   SparForte Docs: doc/pkg_gnat_cgi.html
-----------------------------------------------------------------------------

procedure ParseGnatCGICookieKey( result : out storage; kind : out identifier ) is
  posExpr  : storage;
  pos_type : identifier;
  subprogramId : constant identifier := gnat_cgi_cookie_key_t;
begin
  kind := string_t;
  expect( subprogramId );
  expect( symbol_t, "(" );
  ParseExpression( posExpr, pos_type );
  if baseTypesOK( pos_type, positive_t ) then
     null;
  end if;
  expect( symbol_t, ")" );
  if isExecutingCommand then
     begin
       result := storage'( to_unbounded_string(
         gnat.cgi.cookie.key( positive'value( " " & to_string( posExpr.value ) ) )
       ), noMetaTag, sparMetaTags );
     exception when Gnat.Cgi.Data_Error =>
       err( +"data_error exception" );
     when Gnat.Cgi.Parameter_Not_Found =>
       err( +"parameter_not_found exception" );
     when Gnat.Cgi.Cookie.Cookie_Not_Found =>
       err( +"cookie_not_found exception" );
     when others =>
       err_exception_raised;
     end;
  end if;
end ParseGnatCGICookieKey;

#else

procedure ParseGnatCGICookieKey( result : out storage; kind : out identifier ) is
begin
  not_configured;
end ParseGnatCGICookieKey;

#end if;
#if GCGI
-----------------------------------------------------------------------------
--  PARSE GNAT CGI SET COOKIE                             (built-in function)
--
-- AdaScript Syntax: gnat.cgi.cookie.set( k [,v [,c [,d [,m [,p [,s] ] ] ] ] ] )
--       Ada Target: GNAT.CGI.Cookie_Set
--   GNAT Spec File: g-cgi.ads
--   SparForte Docs: doc/pkg_gnat_cgi.html
-----------------------------------------------------------------------------

procedure ParseGnatCGICookieSet is
  keyExpr  : storage;
  key_type : identifier;
  valExpr  : storage;
  val_type : identifier;
  comExpr  : storage;
  com_type : identifier;
  domExpr  : storage;
  dom_type : identifier;
  ageExpr  : storage;
  age_type : identifier;
  pathExpr : storage;
  path_type : identifier;
  secExpr  : storage;
  sec_type : identifier;
  base_type : identifier;
  secure   : boolean := false;
  right_bracket : constant unbounded_string := to_unbounded_string( ")" );
  subprogramId : constant identifier := gnat_cgi_cookie_set_t;
begin
  ageExpr.value := to_unbounded_string( " " & natural'last'img );
  pathExpr.value := to_unbounded_string("/");
  comExpr.value := null_unbounded_string;
  domExpr.value := null_unbounded_string;

  expect( subprogramId );
  expect( symbol_t, "(" );

  -- Is this universal_t handling necessary?  That this should be automatic...
  ParseExpression( keyExpr, key_type ); -- key
  base_type := getBaseType( key_type );
  if base_type = string_t or base_type = uni_string_t or base_type = universal_t then
     expect( symbol_t, "," );
     ParseExpression( valExpr, val_type ); -- value
     base_type := getBaseType( val_type );
     if base_type = string_t or base_type = uni_string_t or base_type = universal_t then
        -- all other parameters optional .  This presents a problem in SparForte
        -- since we don't have named parameters.  We can only assume the they
        -- are optional to the end of the positions.
        if token = symbol_t and identifiers( token ).store.value /= right_bracket then
           expect( symbol_t, "," );
           ParseExpression( comExpr, com_type ); -- comment
           base_type := getBaseType( com_type );
           if base_type = string_t or base_type = uni_string_t or base_type = universal_t then
              if token = symbol_t and identifiers( token ).store.value /= right_bracket  then
                 expect( symbol_t, "," );
                 ParseExpression( domExpr, dom_type ); -- domain
                 base_type := getBaseType( dom_type );
                 if base_type = string_t or base_type = uni_string_t or base_type = universal_t then
                    if token = symbol_t and identifiers( token ).store.value /= right_bracket then
                       expect( symbol_t, "," );
                       ParseExpression( ageExpr, age_type ); -- max-age
                       base_type := getBaseType( age_type );
                       --if intTypesOK( age_type, natural_t ) or base_type = uni_numeric_t or base_type = universal_t then
                       if base_type = natural_t or base_type = uni_numeric_t or base_type = universal_t then
                          if token = symbol_t and identifiers( token ).store.value /= right_bracket then
                             expect( symbol_t, "," );
                             ParseExpression( pathExpr, path_type ); -- path
                             base_type := getBaseType( path_type );
                             if base_type = string_t or base_type = uni_string_t or base_type = universal_t then
                                if token = symbol_t and identifiers( token ).store.value /= right_bracket then
                                   expect( symbol_t, "," );
                                   ParseExpression( secExpr, sec_type ); -- max-age
                                   base_type := getBaseType( sec_type );
                                   if baseTypesOK( base_type, boolean_t ) then
                                      secure := "1" = to_string( secExpr.value );
                                   end if;
                                end if;
                             end if;
                          end if;
                       end if;
                    end if;
                 end if;
              end if;
           end if;
        end if;
     end if;
  end if;
  expect( symbol_t, ")" );
  if isExecutingCommand then
    if metaTagOK( subprogramId, keyExpr ) and
      metaTagOK( subprogramId, valExpr ) and
      metaTagOK( subprogramId, comExpr ) and
      metaTagOK( subprogramId, domExpr ) and
      metaTagOK( subprogramId, ageExpr ) and
      metaTagOK( subprogramId, pathExpr ) then
       begin
          Gnat.Cgi.Cookie.Set(
             to_string( keyExpr.value ),
             to_string( valExpr.value ),
             to_string( comExpr.value ),
             to_string( domExpr.value ),
             natural'value( " " & to_string( ageExpr.value ) ),
             to_string( pathExpr.value ),
             secure
          );
       exception when Gnat.Cgi.Data_Error =>
          err( +"data_error exception" );
       when Gnat.Cgi.Parameter_Not_Found =>
          err( +"parameter_not_found exception" );
       when Gnat.Cgi.Cookie.Cookie_Not_Found =>
          err( +"cookie_not_found exception" );
       when others =>
          err_exception_raised;
       end;
    end if;
  end if;
end ParseGnatCGICookieSet;

#else

procedure ParseGnatCGICookieSet is
begin
  not_configured;
end ParseGnatCGICookieSet;

#end if;
#if GCGI
-----------------------------------------------------------------------------
--  PARSE GNAT CGI DEBUG TEXT OUTPUT                      (built-in function)
--
-- AdaScript Syntax: s := gnat.cgi.debug_text_output
--       Ada Target: GNAT.CGI.Debug_Text_Output
--   GNAT Spec File: g-cgideb.ads
--   SparForte Docs: doc/pkg_gnat_cgi.html
--
-- Returns a plain text version of the CGI runtime environment
-----------------------------------------------------------------------------

procedure ParseGnatCGIDebugTextOutput( result : out storage; kind : out identifier ) is
  subprogramId : constant identifier := gnat_cgi_debug_text_output_t;
begin
  kind := string_t;
  expect( subprogramId );
  if isExecutingCommand then
     if maintenanceOpt then
       err( +"not allowed in maintenance mode" );
     else
       begin
         result := storage'( to_unbounded_string( Gnat.Cgi.Debug.Text_Output ), noMetaTag, sparMetaTags );
       exception when Gnat.Cgi.Data_Error =>
         err( +"data_error exception" );
       when Gnat.Cgi.Parameter_Not_Found =>
         err( +"parameter_not_found exception" );
       when others =>
         err_exception_raised;
       end;
     end if;
  end if;
end ParseGnatCGIDebugTextOutput;

#else

procedure ParseGnatCGIDebugTextOutput( result : out storage; kind : out identifier ) is
begin
  not_configured;
end ParseGnatCGIDebugTextOutput;

#end if;
#if GCGI
-----------------------------------------------------------------------------
