-----------------------------------------------------------------------------

procedure ParseGnatCGIKeyExists( result : out storage; kind : out identifier ) is
  keyExpr : storage;
  key_type : identifier;
  subprogramId : constant identifier := gnat_cgi_key_exists_t;
begin
  kind := boolean_t;
  expect( subprogramId );
  ParseSingleStringParameter( subprogramId, keyExpr, key_type );
  if isExecutingCommand then
    if metaTagOK( subprogramId, keyExpr ) then
       begin
         result := storage'( to_spar_boolean(
           gnat.cgi.key_exists( to_string( keyExpr.value ))
           ), noMetaTag, sparMetaTags );
       exception when Gnat.Cgi.Data_Error =>
         err( +"data_error exception" );
       when Gnat.Cgi.Parameter_Not_Found =>
         err( +"parameter_not_found exception" );
       when others =>
         err_exception_raised;
       end;
    end if;
  end if;
end ParseGnatCGIKeyExists;

#else

procedure ParseGnatCGIKeyExists( result : out storage; kind : out identifier ) is
begin
  not_configured;
end ParseGnatCGIKeyExists;

#end if;
