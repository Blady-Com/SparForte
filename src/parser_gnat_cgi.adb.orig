    if maintenanceOpt then
      err( +"not allowed in maintenance mode" );
    else
      begin
         result := storage'( to_unbounded_string( Gnat.Cgi.Debug.HTML_Output ), noMetaTag, sparMetaTags );
      exception when Gnat.Cgi.Data_Error =>
        err( +"data_error exception" );
      when Gnat.Cgi.Parameter_Not_Found =>
        err( +"parameter_not_found exception" );
